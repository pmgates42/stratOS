{
    "platforms":
    [
        {
            "name": "bcm2xxx",
            "compiler": "aarch64-none-elf-gcc",
            "cflags": [
                "-DEMBEDDED_BUILD=1",
                "-DRPI_VERSION=3",
                "-DRPI_SUB_VERSION=1",
                "-DBCM2XXX_DEBUG_LED_PIN=23",
                "-DSSCHED_TSK_MAX=20",
                "-DSSCHED_SCHED_TICK_US=10000",
                "-Wall",
                "-nostdlib",
                "-nostartfiles",
                "-ffreestanding",
                "-Iinclude",
                "-Iinclude/public",
                "-mgeneral-regs-only"
            ],
            "ldflags": [],
            "link": false,
            "includes": ["platform/bcm2xxx/include"],
            "modules": [
                "boot",
                "bcm2xxx",
                "aarch64",
                "hw_common",
                "ssched",
                "core_drivers",
                "dwc2",
                "hc_sr04",
                "config",
                "snsr"
            ]
        },

        {
            "name": "win-sim",
            "compiler": "gcc",
            "cflags": [
                "-DRPI_VERSION=3",
                "-DRPI_SUB_VERSION=1",
                "-Wall",
                "-Iinclude",
                "-Iinclude/public",
                "-g",
                "-Wextra",
                "-DSSCHED_TSK_MAX=20",
                "-DSSCHED_SCHED_TICK_US=10000"
            ],
            "ldflags": [],
            "includes": ["platform/sim/include"],
            "modules": [
                "boot",
                "platform_sim",
                "ssched",
                "core_drivers",
                "config",
                "snsr"
            ]
        }        

    ],


    "modules": [
        {
            "name": "boot",
            "sources": ["boot/*.c"],
            "includes": ["boot/include", "aarch64/include"]
        },

        {
            "name": "ssched",
            "sources": ["ssched/ssched.c"],
            "includes": ["ssched/include"],
            "cflags": ["-DSSCHED_SHOW_DEBUG_DATA"]
        },

        {
            "name": "core_drivers",
            "sources": ["drivers/core/**/*.c"],
            "includes": ["drivers/core"]
        },

        {
            "name": "platform_sim",
            "sources": ["platform/sim/**/*.c", "platform/sim/**/*.S"],
            "includes": ["platform/sim/include"]
        },

        {
            "name": "bcm2xxx",
            "sources": ["platform/bcm2xxx/*.c"],
            "includes": ["platform/bcm2xxx/include", "aarch64/include"]
        },

        {
            "name": "aarch64",
            "sources": ["aarch64/*.S"],
            "includes": ["aarch64/include"]
        },

        {
            "name": "hw_common",
            "sources": ["platform/hw_common/**/*.c"],
            "includes": ["platform/hw_common"]
        },

        {
            "name": "dwc2",
            "sources": ["drivers/usb/dwc2/*.c"],
            "includes": ["drivers/usb/dwc2"]
        },

        {
            "name": "hc_sr04",
            "sources": ["drivers/hc_sr04/*.c"],
            "includes": ["drivers/hc_sr04"]
        },

        {
            "name": "config",
            "sources": ["common/config/*.c"],
            "includes": ["common/config"]
        },

        {
            "name": "snsr",
            "sources": ["common/snsr/*.c", "common/snsr/dist/*.c"],
            "includes": ["common/snsr", "common/snsr/dist"]
        }
    ]
}