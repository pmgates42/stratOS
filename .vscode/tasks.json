{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "simulator",
            "type": "shell",
            "command": "wsl",
            "args": [
                "bash",
                "-lc",
                "bash ./sim_build.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "build selected test app",
            "type": "shell",
            "command": "wsl",
            "args": [
                "bash",
                "-lc",
                "python3 tools/scripts/build_test_app.py --apps-config test_apps/apps.json --rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build selected test app for debug",
            "type": "shell",
            "command": "wsl",
            "args": [
                "bash",
                "-lc",
                "python3 tools/scripts/build_test_app.py --apps-config test_apps/apps.json --platform win-sim --rebuild --debug-output build/win-sim/debug_test_app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
