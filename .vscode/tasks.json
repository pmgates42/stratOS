{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "simulator",
            "type": "shell",
            "command": "bash",
            "args": ["./sim_build.sh"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "build selected test app",
            "type": "shell",
            "command": "wsl",
            "args": [
                "bash",
                "-lc",
                "python3 strat_build.py ${input:testAppConfig} --apps-config test_apps/apps.json --rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "testAppConfig",
            "type": "pickString",
            "description": "Select test app configuration",
            "options": [
                "sim_sched_rate_test",
                "bcm2xx_sched_rate"
            ],
            "default": "sim_sched_rate_test"
        }
    ]
}
