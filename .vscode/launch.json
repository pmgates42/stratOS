{
"version": "0.2.0",
"configurations": [
    {
        "name": "Create Blank OS Test App",
        "type": "node-terminal",
        "request": "launch",
        "command": "wsl bash -lc \"python3 tools/scripts/create_test_app.py\"",
        "cwd": "${workspaceFolder}"
    },
    {
        "name": "Build + Run Selected Test App",
        "type": "node-terminal",
        "request": "launch",
        "command": "wsl bash -lc \"python3 tools/scripts/build_test_app.py --apps-config test_apps/apps.json --rebuild --run\"",
        "cwd": "${workspaceFolder}"
    },
    {
        "name": "Build + Debug Selected Test App (WSL)",
        "type": "cppdbg",
        "request": "launch",
        "program": "/mnt/c/Users/paulm/repos/stratOS/build/win-sim/debug_test_app",
        "args": [],
        "stopAtEntry": true,
        "cwd": "/mnt/c/Users/paulm/repos/stratOS",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "preLaunchTask": "build selected test app for debug",
        "pipeTransport": {
            "pipeProgram": "C:/Windows/System32/wsl.exe",
            "pipeArgs": ["--"],
            "pipeCwd": "${workspaceFolder}",
            "debuggerPath": "/usr/bin/gdb",
            "quoteArgs": false
        },
        "sourceFileMap": {
            "/mnt/c": "C:\\"
        },
        "setupCommands": [
            {
                "description": "Enable pretty-printing",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    },
    {
        "name": "Build + Debug Simulator (WSL)",
        "type": "cppdbg",
        "request": "launch",
        "program": "/mnt/c/Users/paulm/repos/stratOS/build/win-sim/default",
        "args": [],
        "stopAtEntry": true,
        "cwd": "/mnt/c/Users/paulm/repos/stratOS",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "preLaunchTask": "simulator",
        "pipeTransport": {
            "pipeProgram": "C:/Windows/System32/wsl.exe",
            "pipeArgs": ["--"],
            "pipeCwd": "${workspaceFolder}",
            "debuggerPath": "/usr/bin/gdb",
            "quoteArgs": false
        },
        "sourceFileMap": {
            "/mnt/c": "C:\\"
        },
        "setupCommands": [
            {
                "description": "Enable pretty-printing",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    },
    {
        "name": "Attach Simulator (WSL)",
        "type": "cppdbg",
        "request": "attach",
        "program": "/mnt/c/Users/paulm/repos/stratOS/build/win-sim/default",
        "processId": "${command:pickProcess}",
        "MIMode": "gdb",
        "pipeTransport": {
            "pipeProgram": "C:/Windows/System32/wsl.exe",
            "pipeArgs": ["--"],
            "pipeCwd": "${workspaceFolder}",
            "debuggerPath": "/usr/bin/gdb",
            "quoteArgs": false
        },
        "sourceFileMap": {
            "/mnt/c": "C:\\"
        },
        "setupCommands": [
            {
                "description": "Enable pretty-printing",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ],
        "symbolLoadInfo": {
            "loadAll": true,
            "exceptionList": ""
        }
    }
]
}
