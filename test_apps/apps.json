{
    "applications": [
        {
            "name": "sim_sched_rate_test",
            "output_name": "sim_sched_rate_test",
            "platform": "win-sim",
            "override_cflags": [
                "-USSCHED_SHOW_DEBUG_DATA",
                "-USSCHED_SCHED_TICK_US",
                "-DSSCHED_SCHED_TICK_US=1000"
            ],
            "sources": [
                "common/uapi/strat_os_sched.c",
                "apps/sched_rate_test/app_sched_rate_test.c",
                "test/unit/libs/unity/src/unity.c"
            ],
            "includes": [
                "common/uapi",
                "apps/sched_rate_test",
                "test/unit/libs/unity/src"
            ],
            "cflags": [
                "-DUNITY_EXCLUDE_STDINT_H"
            ]
        },
        {
            "name": "bcm2xx_sched_rate",
            "output_name": "bcm2xx_sched_rate",
            "platform": "bcm2xxx",
            "sources": [
                "common/uapi/strat_os_sched.c",
                "apps/sched_rate_test/app_sched_rate_test.c",
                "test/unit/libs/unity/src/unity.c"
            ],
            "includes": [
                "common/uapi",
                "apps/sched_rate_test",
                "test/unit/libs/unity/src"
            ],
            "cflags": [
                "-DUNITY_EXCLUDE_STDINT_H",
                "-DUNITY_EXCLUDE_FLOAT",
                "-DUNITY_EXCLUDE_DOUBLE",
                "-DUNITY_EXCLUDE_FLOAT_PRINT",
                "-DUNITY_EXCLUDE_SETJMP_H",
                "-DUNITY_OUTPUT_CHAR(a)=putc(0,(char)(a))",
                "-DUNITY_OUTPUT_CHAR_HEADER_DECLARATION=putc(void* p,char c)"
            ]
        },
        {
            "name": "sim_timer",
            "output_name": "sim_timer",
            "platform": "win-sim",
            "override_cflags": [
                "-USSCHED_SHOW_DEBUG_DATA"
            ],
            "sources": [
                "common/uapi/strat_os_sched.c",
                "apps/timer/app_timer.c"
            ],
            "includes": [
                "common/uapi",
                "apps/timer"
            ]
        },
        {
            "name": "bcm2xx_timer",
            "output_name": "bcm2xx_timer",
            "platform": "bcm2xxx",
            "override_cflags": [
                "-USSCHED_SHOW_DEBUG_DATA"
            ],
            "sources": [
                "common/uapi/strat_os_sched.c",
                "apps/timer/app_timer.c"
            ],
            "includes": [
                "common/uapi",
                "apps/timer"
            ]
        }
    ]
